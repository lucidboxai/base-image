# Top-level configuration

{
  auto_https off
  log {
      level warn
  }
  servers {
      listener_wrappers {
          {$CADDY_TLS_ELEVATION_STRING}
      }
  }
}

# Aim to be as secure as Basic Auth:
# One token, unencrypted, passed in each request via cookie
# Insecure without SSL but will stop port-sniffers gaining free access
# Token visible to logged-in users at :1111/ for simple pre-authentication

(universal-config) {
    {$CADDY_TLS_LISTEN_STRING}
    root * /opt/caddy/public
    @authenticating_bearer {
        expression \
            {http.request.header.authorization} == "Bearer {$WEB_TOKEN}" || \
            {http.request.uri.query.token} == "{$WEB_TOKEN}"
    }
    
    # Password/basic logins are invalidated when set-web-credentials is used
    @authenticating_basic {
        expression \
            {http.request.header.authorization} == "Basic {$WEB_PASSWORD_B64}" || \
            {http.request.uri.query.token} == "{$WEB_PASSWORD_B64}"
    }
    
    @authorized {
        expression \
            {http.request.cookie.{$CADDY_AUTH_COOKIE_NAME}} == "{$WEB_TOKEN}" || \
            {http.request.cookie.{$CADDY_AUTH_COOKIE_NAME}} == "{$WEB_PASSWORD_B64}" || \
            {http.request.header.authorization} == "Bearer {$WEB_TOKEN}" || \
            {http.request.uri.query.token} == "{$WEB_TOKEN}" || \
            {http.request.header.authorization} == "Basic {$WEB_PASSWORD_B64}" || \
            {http.request.uri.query.token} == "{$WEB_PASSWORD_B64}" || \
            "{$WEB_ENABLE_AUTH}" == "false"
    }
    
    @preauth {
        path /ai-dock/pre-auth
    }

    # Flag the session cookie Secure only when the browser's connection really
    # is https, so it is not silently dropped on plain-http runs (local
    # docker-compose, TCP-mapped ports). A wrongly-set Secure flag is a login
    # loop: the cookie is stored but never sent back.
    #
    # The host checks are deliberate: RunPod and trycloudflare terminate TLS at
    # their edge and speak http to this container, so neither the request scheme
    # nor X-Forwarded-Proto is reliable there. Same reasoning as direct-url.sh
    # (PORT-020) and cfqt-url.sh, which hardcode https for exactly these hosts.
    # Everything defaults to no flag, so an unrecognised ingress fails open
    # rather than locking the operator out.
    @secure_ctx {
        expression \
            {http.request.scheme} == "https" || \
            {http.request.header.x-forwarded-proto} == "https" || \
            {http.request.host}.endsWith(".proxy.runpod.net") || \
            {http.request.host}.endsWith(".trycloudflare.com")
    }
    vars cookie_secure ""
    vars @secure_ctx cookie_secure "; Secure"

    
    @default {
        path /*
    }

    handle_errors 502 {
        rewrite * /502.html
        file_server
    }
        
    respond /ai-dock/health-check 200
}

